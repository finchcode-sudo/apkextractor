<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Android 11+
        允许应用广泛查询设备上的已安装应用。

        如果你的 App 是应用管理器/应用分享器等，
        并且核心功能确实需要查看大量已安装应用，可以使用。
    -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!--
        前台服务基础权限。
        Android 9+。
    -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE" />

    <!--
        Android 13+
        如果前台服务需要显示通知，需要申请通知权限。
    -->
    <uses-permission
        android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        Android 6.0+
        允许应用请求用户将本 App 加入电池优化豁免列表。

        注意：
        这不是自动获得白名单，只是允许发起系统请求。
    -->
    <uses-permission
        android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!--
        Android 8.0+
        通过 PackageInstaller 的 Session API 直接安装应用（含分包 .apks/.xapk/.apkm/.apkx）
        必须声明此权限，用户还需要在系统设置里为本 App 打开"允许安装未知应用"。
    -->
    <uses-permission
        android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".MyApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- ========================================== -->
        <!-- 主 Activity -->
        <!-- ========================================== -->

        <activity
            android:name=".ComposeMainActivity"
            android:exported="true"
            android:theme="@style/AppTheme.NoActionBar"
            android:enableOnBackInvokedCallback="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>


        <!-- ========================================== -->
        <!-- FileProvider -->
        <!-- ========================================== -->

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="info.muge.appshare.FileProvider"
            android:exported="false"
            android:grantUriPermissions="true">

            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />

        </provider>


        <!-- ========================================== -->
        <!-- 应用安装 / 卸载 / 更新广播 -->
        <!-- ========================================== -->

        <receiver
            android:name=".utils.PackageChangeReceiver"
            android:exported="true">

            <intent-filter>

                <!-- 安装应用 -->
                <action android:name="android.intent.action.PACKAGE_ADDED" />

                <!-- 卸载应用 -->
                <action android:name="android.intent.action.PACKAGE_REMOVED" />

                <!-- 更新应用 -->
                <action android:name="android.intent.action.PACKAGE_REPLACED" />

                <!-- package 广播必须使用 package scheme -->
                <data android:scheme="package" />

            </intent-filter>

        </receiver>


        <!-- ========================================== -->
        <!-- 分包安装（.apks/.xapk/.apkm/.apkx）安装结果回调 -->
        <!-- 仅由本 App 通过 PendingIntent 内部触发，不对外暴露 -->
        <!-- ========================================== -->

        <receiver
            android:name=".utils.InstallResultReceiver"
            android:exported="false" />


        <!-- ========================================== -->
        <!-- 前台服务 -->
        <!-- ========================================== -->

        <service
            android:name=".service.AppMonitorService"
            android:exported="false"
            android:foregroundServiceType="specialUse">

            <!--
                Android 14+
                specialUse 类型需要说明具体用途。
            -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="持续监控设备上的应用状态变化" />

        </service>


        <!-- ========================================== -->
        <!-- 其他 Meta-data -->
        <!-- ========================================== -->

        <meta-data
            android:name="android.max_aspect"
            android:value="2.4" />

    </application>

</manifest>
